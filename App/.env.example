# Copy to .env and fill with your Supabase (or local Docker) values.
# REQUIRED for the live Next.js ledger API (hydrate + persist).
# Prisma migrate needs DIRECT_URL (session/direct, port 5432).
# The API uses DATABASE_URL (pooler port 6543 with ?pgbouncer=true for Supabase).
# Without these, seed/commands return HTTP 503 "database not configured".

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ankuaru_sim"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/ankuaru_sim"

# Supabase example (replace placeholders):
# DATABASE_URL="postgresql://postgres.<projectRef>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<projectRef>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

PORT=3001
# Legacy Fastify-only CORS (not needed when UI+API are the same Next.js app)
WEB_ORIGIN=http://localhost:3000
EVIDENCE_DIR=./data/evidence
REPORTS_DIR=./data/reports
JWT_SECRET=dev-change-me-ankuaru-sim

# Web (apps/web/.env.local) — leave empty for same-origin Next API:
# NEXT_PUBLIC_API_URL=
# Or point at a standalone API:
# NEXT_PUBLIC_API_URL=https://traceablity-v2.onrender.com
